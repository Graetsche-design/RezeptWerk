<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Nur der Start-Hintergrund wird hier festgelegt: ein dunkler Anthrazit,
	  passend zum Splashscreen. Dadurch gibt es beim App-Start kein weißes
	  Aufblitzen, sondern einen nahtlosen Übergang dunkel → dunkler Splash.

	  Alle übrigen Info.plist-Werte erzeugt Xcode weiterhin automatisch
	  (Build-Einstellung „Generate Info.plist File = YES“).
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  RezeptWerk spricht Deutsch — alle Texte stehen direkt im Code. Damit
	  Siri die deutschen Kurzbefehl-Sätze („Nächster Schritt in RezeptWerk“,
	  siehe CookingIntents) der App zuordnet, weist die App Deutsch als
	  Sprache aus.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>

	<!--
	  Hintergrund-Modus für die iCloud-Synchronisierung: CloudKit benötigt
	  „remote-notification“, um Änderungen von anderen Geräten zu empfangen.
	  Schadet nicht, wenn iCloud aus ist.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Rezept-Tausch: RezeptWerk registriert die eigene Dateiendung
	  „.rezeptwerk“. Wer so eine Datei antippt (Mail, WhatsApp, Dateien …),
	  landet direkt in der Editor-Vorschau der App (siehe RecipeShareService
	  und der onOpenURL-Handler in RootView).
	-->
	<!--
	  „In-place öffnen": Beim Antippen einer .rezeptwerk-Datei liest die
	  App die Datei direkt an ihrem Ort (mit Sicherheits-Schranke, siehe
	  RecipeShareService.loadRecipe), statt dass iOS erst eine Kopie in
	  den App-Ordner legt — solche Kopien würden sich sonst unsichtbar
	  ansammeln. Behebt außerdem die Xcode-Warnung „doesn't declare
	  whether it supports opening them in place".
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>RezeptWerk-Rezept</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.rezeptwerk.app.recipe</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.rezeptwerk.app.recipe</string>
			<key>UTTypeDescription</key>
			<string>RezeptWerk-Rezept</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rezeptwerk</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
