<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Gemeinsame App-Gruppe mit der Haupt-App: Darüber liest das Widget den
	  Wochenplan-Schnappschuss (siehe WidgetPlanSync in der App).

	  Wie bei der Teilen-Erweiterung gilt: Fürs echte Gerät muss die
	  Capability „App Groups“ einmalig in Xcode für dieses Target aktiviert
	  werden (Signing & Capabilities → + Capability → App Groups →
	  „group.de.rezeptwerk.app“ ankreuzen). Im Simulator genügt diese Datei.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.rezeptwerk.app</string>
	</array>
</dict>
</plist>
